############################
# OS / editor noise
############################
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/

############################
# Logs
############################
npm-debug.log*
yarn-debug.log*
yarn-error.log*

############################
# Node / frontend
############################
node_modules/
dist/
.vite/

############################
# Python
############################
__pycache__/
*.py[cod]
server/venv/
server/__pycache__/

############################
# Environment variables (NEVER COMMIT)
############################
.env
.env.*
family-gallery/.env*
server/.env*
!.env.example

############################
# Docker
############################
docker-compose.override.yml

############################
# AWS credentials (NEVER COMMIT)
############################
.aws/
*.pem

############################
# Apache / SSL sensitive files
############################
apache/certs/certs/*
apache/certs/private/*

# Keep directory structure
!apache/certs/
!apache/certs/certs/
!apache/certs/private/

############################
# System SSL leftovers
############################
etc/ssl/certs/
etc/ssl/private/

############################
# Runtime cache / generated backend data
############################
server/cache/*
!server/cache/.gitkeep

############################
# Media repositories (large / generated)
############################
PHOTO_VIDEO_REPOSITORY/
**/photos/originals/**
**/videos/originals/**
**/cache-image/**

############################
# GitHub Actions
############################
!.github/
!.github/workflows/
############################
# DMP noise (safe)
############################
dmp/**/.DS_Store
dmp/**/*.log